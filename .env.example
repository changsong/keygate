# ─── Server ───────────────────────────────────────
PORT=9000
ENVIRONMENT=development    # development | staging | production
BASE_URL=http://localhost:9000

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgres://keygate:keygate@localhost:5432/keygate?sslmode=disable

# ─── Security (required, generate with: openssl rand -hex 32) ───
JWT_SECRET=
LICENSE_SIGNING_KEY=

# ─── Payments (Stripe) ──────────────────────────
# Stripe: https://dashboard.stripe.com/apikeys
# Only STRIPE_SECRET_KEY is required. Webhook is auto-configured.
STRIPE_SECRET_KEY=

# ─── Email (optional, OTP codes print to logs if not set) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Either a bare address or the display-name form. The name is what
# recipients see in their inbox; the envelope sender is stripped to the
# bare address automatically.
#   SMTP_FROM=noreply@example.com
#   SMTP_FROM=Acme Licensing <noreply@example.com>
SMTP_FROM=

# ─── Redis-compatible endpoint (optional; Redis or Valkey) ───
# When set, rate limits are shared across instances. Unset (default): each
# instance limits on its own, in memory, so with N instances a client can
# get N times the limit. On a slow/down endpoint, requests fail fast and
# rate limiting degrades to in-memory until Redis is back.
# Example: redis://localhost:6379/0 (a bare host:port also works)
REDIS_URL=

# ─── Rate Limits (requests per minute) ───────────
RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
# Login/OTP-verify budget per IP per minute. Offices behind one NAT share it.
RATE_LIMIT_AUTH=60
# Login codes per IP per HOUR. Deliberately tight: this endpoint mails
# an address the caller supplies, so a loose budget lets someone use
# your server (and your sending reputation) to spam third parties.
RATE_LIMIT_OTP_SEND=30

# ─── Client address ──────────────────────────────
# Rate limits and lockouts count per client IP. X-Forwarded-For and
# X-Real-Ip are believed only from these proxies (IPs or CIDRs, comma
# separated). Unset or empty trusts private networks; "none" trusts no
# proxy. Name your HTTP proxy's own address as Keygate sees it, e.g.
# 127.0.0.1,::1 for nginx or Caddy on the same host; the proxy must set
# or append X-Forwarded-For and overwrite X-Real-Ip. Never name a plain
# TCP forwarder: it passes a client's own headers through. With no HTTP
# proxy in front (port 9000 published directly), set "none".
TRUSTED_PROXIES=

# ─── Webhooks ────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL=30s
WEBHOOK_HTTP_TIMEOUT=10s
# Allow webhook deliveries to loopback/private/link-local addresses
# (e.g. a receiver on the same Docker network). Off by default.
# Also required when outbound traffic goes through HTTP_PROXY and only the
# proxy can resolve DNS: the server classifies proxied targets by resolving
# them itself and refuses names it cannot resolve.
WEBHOOK_ALLOW_PRIVATE=false

# ─── Quotas ──────────────────────────────────────
QUOTA_WARNING_THRESHOLD=0.8

# ─── Casdoor SSO (optional) ──────────────────────
# Add a "Sign in with Casdoor" option to the login page. Leave the
# issuer empty to keep email OTP only. When any of ISSUER/CLIENT_ID/
# CLIENT_SECRET/REDIRECT_URL is set, all four are required.
# Create an application in Casdoor with this redirect URI, grant types
# authorization_code + refresh_token + client_credentials, scopes
# "openid profile email", TokenFormat=JWT-Standard, and email
# verification enabled.
CASDOOR_ISSUER_URL=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# Defaults to BASE_URL + /api/v1/auth/casdoor/callback when ISSUER is set.
CASDOOR_REDIRECT_URL=
# Shared secret Casdoor sends as X-Keygate-Webhook-Secret on event
# deliveries. Leave empty to disable the webhook endpoint.
CASDOOR_WEBHOOK_SECRET=
# Organization the daily reconciliation pass reads (get-users). Required
# for reconciliation; the webhook and login work without it.
CASDOOR_ORG=
# Login button label.
CASDOOR_DISPLAY_NAME=Casdoor
# Extra OIDC audiences accepted by POST /api/v1/auth/casdoor/exchange for
# desktop clients (comma separated). The web client ID is always accepted.
CASDOOR_DESKTOP_CLIENT_IDS=

# ─── Multi-tenancy (optional) ────────────────────
# Off by default: the install is one workspace and every request uses
# the default tenant. Turn it on to serve several customers from one
# instance, each at <slug>.<TENANT_ROOT_DOMAIN>, with the platform
# console at PLATFORM_HOST. All three of ENABLED, ROOT_DOMAIN and
# PLATFORM_HOST are required together.
TENANT_ENABLED=false
# e.g. keygate.app (no scheme).
TENANT_ROOT_DOMAIN=
# e.g. app.keygate.app, the platform console (no tenant).
PLATFORM_HOST=
# Cookie Domain for the session. In production set it to
# .<TENANT_ROOT_DOMAIN> so a session issued on the platform callback is
# sent to every tenant subdomain. Empty means host-only.
SESSION_COOKIE_DOMAIN=
# Accept X-Tenant / ?tenant= outside production (development only).
TENANT_DEV_OVERRIDE=false
# Workspace a bare root-domain request and all pre-multi-tenant data
# belong to. Must be 2-32 lowercase letters, digits or hyphens.
DEFAULT_TENANT_SLUG=default

# ─── Admin Bootstrap ─────────────────────────────
# Comma-separated emails to auto-promote to admin on first login
# (to owner while the install has no owner). When set, only these
# emails can complete first-run setup.
ADMIN_EMAILS=

# ─── Release storage (optional, S3-compatible) ───
# Needed for release management (artifact uploads, update feeds,
# license-gated downloads). Leave STORAGE_BUCKET empty to turn it off;
# license and billing features work without it. BUCKET, ACCESS_KEY and
# SECRET_KEY must be set together.
# Endpoint: empty for AWS S3, e.g. https://<account>.r2.cloudflarestorage.com
# for Cloudflare R2, or http://minio:9000 for MinIO.
STORAGE_ENDPOINT=
# Region: auto for R2, the bucket's region for AWS S3.
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# true for MinIO and most self-hosted S3 gateways.
STORAGE_FORCE_PATH_STYLE=false
# Presigned URL lifetimes
STORAGE_UPLOAD_TTL=1h
STORAGE_DOWNLOAD_TTL=10m
# Lifetime of artifact URLs inside public update feeds (Sparkle/Velopack/Tauri).
# Users may click Install long after the feed was fetched.
STORAGE_FEED_URL_TTL=24h

# Master key that encrypts secrets at rest: release-signing keys, email
# provider credentials and license keys. Required when release storage
# is enabled; recommended in any production install.
# Generate with: openssl rand -hex 32
# Keep it safe and stable: losing or changing it makes existing signing
# keys undecryptable, and signing then fails.
RELEASE_KEY_ENCRYPTION_KEY=

# Largest artifact the server will read, hash and sign at publish, in MB.
MAX_RELEASE_SIGN_SIZE_MB=500
